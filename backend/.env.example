# EventMate Backend - Environment Variables
# Copy this file to .env and fill in the values

# MongoDB Atlas connection string (get from atlas.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eventmate?retryWrites=true&w=majority

# JWT Secret (any long random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Your Vercel frontend URL (set after Vercel deployment)
FRONTEND_URL=https://your-app.vercel.app

# Server Port (Render sets this automatically)
PORT=5000
